// RUGUPDT.EXE resources: icon (the game's), manifest, version information.
#include <winver.h>
#pragma code_page(65001)

1 ICON "rugupdt.ico"
1 24 "rugupdt.manifest"

#define UPDT_VERSION     1,0,0,0
#define UPDT_VERSION_STR "1.0.0.0"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     UPDT_VERSION
PRODUCTVERSION  UPDT_VERSION
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName",      "T.M. DEVELOPMENTS"
      VALUE "FileDescription",  "Rugrats Adventure Game (x64) Updater"
      VALUE "FileVersion",      UPDT_VERSION_STR
      VALUE "InternalName",     "rugupdt"
      VALUE "OriginalFilename", "RUGUPDT.EXE"
      VALUE "ProductName",      "Rugrats Adventure Game (x64)"
      VALUE "ProductVersion",   UPDT_VERSION_STR
      VALUE "LegalCopyright",   "© 2026 T.M. DEVELOPMENTS. GNU GPL v3 or later."
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
